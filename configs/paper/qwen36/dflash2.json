{
  "algorithm": {
    "name": "dflash2",
    "dflash2": {
      "conv_kernel_size": 2,
      "conv_group_size": 16,
      "selector_rank": 256,
      "selector_top_k": 16,
      "selector_loss_alpha": 1.0,
      "kd_chunk_size": 1024
    }
  },
  "target": {
    "model": "${VELADRAFT_TARGET:-assets/models/Qwen3.6-35B-A3B}",
    "dtype": "bfloat16",
    "attn_implementation": "sdpa",
    "device": "cuda:0",
    "local_files_only": true,
    "image_min_pixels": 65536,
    "image_max_pixels": 1048576,
    "device_map": "sequential",
    "max_memory": {
      "0": "62GiB",
      "1": "40GiB"
    },
    "chat_template_kwargs": {
      "enable_thinking": false
    }
  },
  "dataset": {
    "slice": 660000,
    "val_size": 64,
    "seed": 42,
    "min_answer_chars": 600,
    "source": "jsonl",
    "path": "${VELADRAFT_DATA_ROOT:-data/qwen36}/pool.jsonl",
    "split_field": "split",
    "image_link_mode": "hardlink"
  },
  "regen": {
    "max_new_tokens": 2048,
    "min_response_tokens": 8,
    "batch_size": 8,
    "temperature": 0.7,
    "backend": "vllm",
    "top_p": 0.8,
    "top_k": 20,
    "presence_penalty": 1.5,
    "repetition_penalty": 1.0,
    "max_prompt_tokens": 2048,
    "window_tokens": 4096,
    "seed": 42,
    "multi_turn_mode": "last_turn_only",
    "select": {
      "meta": "${VELADRAFT_DATA_ROOT:-data/qwen36}/pool_meta.jsonl",
      "quotas": {
        "general": 140000,
        "ocr": 120000,
        "chart": 60000,
        "reasoning": 80000
      }
    }
  },
  "capture": {
    "seq_length": 4096,
    "shard_size": 32,
    "dtype": "bfloat16",
    "visual_path_check": true,
    "visual_check_samples": 2,
    "store_final_hidden": true
  },
  "drafter": {
    "num_hidden_layers": 3,
    "block_size": 8,
    "num_anchors": 512,
    "loss_decay_gamma": 7.0,
    "mask_token_id": 248077,
    "attention_backend": "flex_attention",
    "spatial_rope_enabled": true,
    "spatial_rope_mode": "replace",
    "intermediate_size": 6144
  },
  "train": {
    "feature_mode": "online",
    "micro_batch_size": 2,
    "grad_accumulation_steps": 8,
    "num_epochs": 3,
    "lr": 0.0001,
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.0,
    "warmup_ratio": 0.04000666666666667,
    "min_lr_ratio": 0.1,
    "max_grad_norm": 1.0,
    "log_every_steps": 10,
    "seed": 42,
    "device": "cuda:1",
    "overfit_sanity": {
      "enabled": true,
      "num_samples": 4,
      "steps": 200,
      "ce_drop": 0.6,
      "slot0_acc": 0.9
    },
    "online_feature_cache_gb": 0,
    "online_batch_size": 2,
    "num_workers": 0,
    "draft_dtype": "bfloat16",
    "save_every_steps": 1250,
    "milestone_snapshots": true
  },
  "eval": {
    "num_prompts": 64,
    "max_new_tokens": 128,
    "sequential_target_verification": true,
    "verify_sdpa_backend": "parity",
    "parallel_diagnostic_prompts": 16,
    "checkpoints": [
      "ckpt_final.pt",
      "ckpt_init.pt"
    ]
  },
  "run": {
    "name": "qwen3.6-35b-a3b-dflash2-online",
    "dir": "${VELADRAFT_RUN_ROOT:-runs/paper}/qwen36/dflash2"
  }
}
