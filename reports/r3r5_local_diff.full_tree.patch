diff --git a/scripts/prepare_benchmark.py b/scripts/prepare_benchmark.py
index 08ae21d..0708665 100644
--- a/scripts/prepare_benchmark.py
+++ b/scripts/prepare_benchmark.py
@@ -11,7 +11,11 @@ pinned protocol is reviewable in git. Images and prompt jsonl stay under
 fixed subset size, fixed seed.
 
 Workloads: ``textvqa`` (lmms-lab/textvqa validation), ``docvqa``
-(lmms-lab/DocVQA DocVQA/validation), ``chartqa`` (lmms-lab/ChartQA test).
+(lmms-lab/DocVQA DocVQA/validation), ``chartqa`` (lmms-lab/ChartQA test),
+``gqa`` (GQA balanced split, local release), ``mantis`` (TIGER-Lab/Mantis-Eval
+test split, multi-image). Exports always write the ``labels.jsonl`` sidecar
+(answers never enter the prompts). ``gqa``/``mantis`` are new in the
+CVPR-benchmark layer.
 """
 
 from __future__ import annotations
@@ -25,13 +29,21 @@ sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
 from vlm_dflash.benchmark.adapters import (  # noqa: E402
     export_chartqa,
     export_docvqa,
+    export_gqa,
+    export_mantis,
     export_textvqa,
     pinned_prompt_manifest,
 )
 from vlm_dflash.utils import log, write_jsonl  # noqa: E402
 
 REPO_ROOT = Path(__file__).resolve().parents[1]
-_ADAPTERS = {"textvqa": export_textvqa, "docvqa": export_docvqa, "chartqa": export_chartqa}
+_ADAPTERS = {
+    "textvqa": export_textvqa,
+    "docvqa": export_docvqa,
+    "chartqa": export_chartqa,
+    "gqa": export_gqa,
+    "mantis": export_mantis,
+}
 
 
 def main() -> None:
@@ -40,15 +52,26 @@ def main() -> None:
     parser.add_argument("--source", required=True, help="local download of the upstream dataset")
     parser.add_argument("--out", default=None, help="export directory (default: benchmarks/data/<workload>)")
     parser.add_argument("--prompts-out", default=None, help="prompt manifest path (default: benchmarks/prompts/<workload>_v1.jsonl)")
-    parser.add_argument("--num-prompts", type=int, default=128)
+    parser.add_argument(
+        "--num-prompts",
+        type=int,
+        default=None,
+        help="subset size (default: 128; mantis defaults to its full split)",
+    )
     parser.add_argument("--seed", type=int, default=42)
     args = parser.parse_args()
 
     out_dir = Path(args.out) if args.out else REPO_ROOT / "benchmarks" / "data" / args.workload
     prompts_out = Path(args.prompts_out) if args.prompts_out else REPO_ROOT / "benchmarks" / "prompts" / f"{args.workload}_v1.jsonl"
-    manifest = _ADAPTERS[args.workload](
-        args.source, out_dir, num_prompts=args.num_prompts, seed=args.seed
-    )
+    num_prompts = args.num_prompts
+    if num_prompts is None:
+        num_prompts = 128
+    if args.workload == "mantis" and args.num_prompts is None:
+        manifest = export_mantis(args.source, out_dir, num_prompts=None, seed=args.seed)
+    else:
+        manifest = _ADAPTERS[args.workload](
+            args.source, out_dir, num_prompts=num_prompts, seed=args.seed
+        )
     write_jsonl(prompts_out, pinned_prompt_manifest(manifest))
     log(f"prepare_benchmark: prompt manifest -> {prompts_out}")
     log(f"prepare_benchmark: rows_sha256={manifest['rows_sha256']}")
