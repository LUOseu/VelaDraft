+    for index in indices:
+        row = rows[index]
+        sample_id = f"mantis-{str(row.get('id', index)).zfill(4)}"
+        images = list(row["images"])
+        image_names = []
+        image_hashes = {}
+        for image_index, image in enumerate(images):
+            suffix = _image_suffix(image["bytes"])
+            image_name = f"{sample_id}-{image_index}{suffix}"
+            image_path = images_dir / image_name
+            _write_image(image_path, image["bytes"])
+            image_names.append(image_name)
+            image_hashes[image_name] = sha256_file(image_path)
+        question_type = str(row["question_type"])
+        question = str(row["question"]).strip()
+        prompt_text = _mantis_question_text(question_type, question, row.get("options"))
+        prompt_rows.append(
+            {
+                "id": sample_id,
+                "conversations": [
+                    {"from": "human", "value": prompt_text},
+                    {"from": "gpt", "value": ""},
+                ],
+                "images": image_names,
+            }
+        )
+        label_rows.append(
+            {
+                "id": sample_id,
+                "question_type": question_type,
+                "answer": str(row["answer"]),
+                "options": (
+                    [str(option) for option in row["options"]]
