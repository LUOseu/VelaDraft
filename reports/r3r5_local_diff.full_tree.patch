+        "p10": quantile(0.1),
+        "median": quantile(0.5),
+        "p90": quantile(0.9),
+        "max": ordered[-1],
+        "mean": sum(ordered) / len(ordered),
+    }
+    if cap is not None:
+        summary["cap"] = int(cap)
+        summary["at_cap"] = sum(1 for value in ordered if value >= cap)
+        summary["at_cap_fraction"] = summary["at_cap"] / len(ordered)
+    return summary
