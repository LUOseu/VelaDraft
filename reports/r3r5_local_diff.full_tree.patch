+def _gqa_is_balanced(value) -> bool:
+    if isinstance(value, bool):
+        return value
+    return str(value).strip().lower() in {"true", "1", "yes"}
+
+
+def _gqa_load_questions(source_dir: Path, split: str) -> tuple[list[dict], dict[str, str]]:
+    """Load GQA question rows from any of the common release layouts.
+
+    Supported layouts (checked in order):
+    1. classic release: ``<split>_questions.json`` mapping qid -> row;
+    2. sharded instructions: ``<split>_instructions/*.parquet`` (HuggingFace
+       ``lmms-lab-encoder/GQA`` layout; an ``isBalanced`` column, when present,
+       is filtered to the balanced subset for ``*_balanced`` splits);
+    3. sharded instructions: ``<split>_instructions/*.json(``l``)``.
+    Returns the rows (sorted by numeric id when possible) and file hashes.
+    """
+    import json as jsonlib
+
+    rows, file_hashes = [], {}
+    single = source_dir / f"{split}_questions.json"
+    if single.exists():
+        with open(single, "r", encoding="utf-8") as handle:
+            data = jsonlib.load(handle)
+        for qid, row in data.items():
+            row = dict(row)
+            row.setdefault("id", qid)
+            rows.append(row)
+        file_hashes[single.name] = sha256_file(single)
+    else:
+        instructions_dir = source_dir / f"{split}_instructions"
+        if not instructions_dir.exists():
+            instructions_dir = source_dir / "instructions"
+        parquets = sorted(instructions_dir.glob("*.parquet"))
+        if parquets:
+            import pyarrow.parquet as pq
+
+            for shard in parquets:
+                shard_rows = pq.read_table(shard).to_pylist()
+                if split.endswith("balanced") and "isBalanced" in (shard_rows[0] if shard_rows else {}):
+                    shard_rows = [
+                        row for row in shard_rows if _gqa_is_balanced(row["isBalanced"])
+                    ]
+                rows.extend(dict(row) for row in shard_rows)
+                file_hashes[shard.name] = sha256_file(shard)
+        else:
+            files = sorted(instructions_dir.glob("*.json")) + sorted(instructions_dir.glob("*.jsonl"))
+            if not files:
+                raise FileNotFoundError(
+                    f"No {split}_questions.json or {split}_instructions/*.(json|jsonl|parquet) "
+                    f"under {source_dir}."
+                )
+            for path in files:
+                if path.suffix == ".jsonl":
+                    with open(path, "r", encoding="utf-8") as handle:
+                        part = [jsonlib.loads(line) for line in handle if line.strip()]
+                else:
+                    with open(path, "r", encoding="utf-8") as handle:
+                        part = jsonlib.load(handle)
+                    if isinstance(part, dict) and "id" not in part:
+                        part = list(part.values())
+                rows.extend(dict(row) for row in part)
+                file_hashes[path.name] = sha256_file(path)
+
+    def sort_key(row: dict):
+        qid = str(row.get("id", ""))
+        try:
+            return (0, int(qid), "")
+        except ValueError:
+            return (1, 0, qid)
+
+    rows.sort(key=sort_key)
+    return rows, file_hashes
+
+
+def _gqa_parquet_image_index(source_dir: Path, split: str) -> dict[str, dict]:
+    """Map ``imageId -> {"bytes": ...}`` from ``<split>_images/*.parquet``."""
+    import pyarrow.parquet as pq
+
+    index: dict[str, dict] = {}
+    images_dir = source_dir / f"{split}_images"
+    for shard in sorted(images_dir.glob("*.parquet")):
+        for row in pq.read_table(shard, columns=["id", "image"]).to_pylist():
+            index[str(row["id"])] = row["image"]
+    return index
+
+
+def _gqa_image_path(source_dir: Path, split: str, image_id: str) -> Path | None:
+    for candidate in (
+        source_dir / f"{split}_images" / f"{image_id}.jpg",
+        source_dir / "images" / f"{image_id}.jpg",
+        source_dir / f"{split}_images" / f"{image_id}.png",
+        source_dir / "images" / f"{image_id}.png",
+    ):
+        if candidate.exists():
+            return candidate
+    return None
+
