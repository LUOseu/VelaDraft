+                "num_images": len(image_names),
+            }
+        )
+
+    write_jsonl(out_dir / "mantis_v1.jsonl", prompt_rows)
+    labels_sha256 = _write_labels(out_dir, label_rows)
+    write_json(out_dir / "meta.json", {"media_dir": "images", "source": MANTIS_DATASET})
+    manifest = {
+        "created": now_iso(),
+        "dataset": MANTIS_DATASET,
+        "split": "test",
+        "source_dir": str(source_dir.resolve()),
+        "num_rows_in_split": len(rows),
+        "num_prompts": len(prompt_rows),
+        "seed": seed,
+        "subset": "full split" if num_prompts is None else f"seeded sample of {num_prompts} (seed={seed})",
+        "shards": shard_hashes,
+        "rows_sha256": sha256_json(manifest_rows),
+        "labels_sha256": labels_sha256,
+        "rows": manifest_rows,
+    }
+    write_json(out_dir / "manifest.json", manifest)
+    log(
+        f"benchmark adapter: mantis -> {out_dir} ({len(prompt_rows)} prompts, "
+        f"rows_sha256={manifest['rows_sha256'][:12]}, labels_sha256={labels_sha256[:12]})"
+    )
+    return manifest
