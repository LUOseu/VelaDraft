{
  "version": 1,
  "description": "VelaDraft A100 experiment matrix: multimodal parallel-drafter benchmark (controlled + native tracks) with the D1 regroup systems factor. Runner: research/convergence/a100/run_matrix.py (dry-run / run / resume / summarize).",
  "repo": "${VELADRAFT_REPO}",
  "python": "${VELADRAFT_PYTHON}",
  "runs_root": "${VELADRAFT_RUNS_ROOT}",
  "controlled_config": "configs/qwen2_5_vl_3b_2k.yaml",
  "env": {
    "VLM_DFLASH_TARGET": "${VELADRAFT_TARGET_MODEL}",
    "VLM_DFLASH_FLEX_FORCE_MAIN": "1"
  },
  "budget": {"steps": 2000, "seeds": [42, 43]},
  "drafters": {
    "dflash":  {"native_config": "configs/qwen2_5_vl_3b_2k.yaml",            "regroup_support": true,  "regroup_adaptation": false},
    "dspark":  {"native_config": "configs/dspark/qwen2_5_vl_3b_2k.yaml",     "regroup_support": false, "regroup_adaptation": false},
    "domino":  {"native_config": "configs/domino/qwen2_5_vl_3b_2k.yaml",     "regroup_support": false, "regroup_adaptation": false},
    "jetspec": {"native_config": "configs/jetspec/qwen2_5_vl_3b_2k.yaml",    "regroup_support": false, "regroup_adaptation": false},
    "dflash2": {"native_config": "configs/dflash2/qwen2_5_vl_3b_2k.yaml",    "regroup_support": false, "regroup_adaptation": false},
    "dflare":  {"native_config": "configs/dflare/qwen2_5_vl_3b_2k.yaml",     "regroup_support": false, "regroup_adaptation": true},
    "dfly":    {"native_config": "configs/dfly/qwen2_5_vl_3b_2k.yaml",       "regroup_support": false, "regroup_adaptation": false}
  },
  "tracks": ["controlled", "native"],
  "regroup_sets": {
    "off":   [],
    "grid2": ["train.regroup.mode=grid", "train.regroup.sub_batch=2", "train.regroup.fp32_weights=true", "train.regroup.identity_bypass=true"]
  },
  "stages": ["train", "eval", "benchmark"],
  "eval": {"num_prompts": 64, "max_new_tokens": 128},
  "isolation": {
    "train_store": "${VELADRAFT_DATA_ROOT}/qwen25vl3b_2k/train_store",
    "val_split": "${VELADRAFT_DATA_ROOT}/qwen25vl3b_2k/val_heldout.jsonl",
    "test_workloads": ["caption_general", "textvqa", "docvqa", "chartqa"],
    "note": "test workloads are public datasets exported by scripts/prepare_benchmark.py; the val split is disjoint from the train store; the runner refuses identical train/val paths"
  },
  "cost_model": {
    "sec_per_step": {"default": 1.3, "dflash": 1.2, "dspark": 1.5, "domino": 1.5, "jetspec": 1.5, "dflash2": 1.4, "dflare": 1.6, "dfly": 1.6},
    "eval_minutes": 12,
    "benchmark_minutes": 10
  }
}
