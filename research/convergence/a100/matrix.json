{
  "version": 2,
  "description": "VelaDraft A100 experiment matrix: multimodal parallel-drafter benchmark (controlled + native tracks) with the D1 regroup systems factor. Runner: research/convergence/a100/run_matrix.py (dry-run / run / resume / summarize); prepare stage binds the declared train store + val split and runs preflight_entry.py before any GPU work.",
  "repo": "${VELADRAFT_REPO}",
  "python": "${VELADRAFT_PYTHON}",
  "runs_root": "${VELADRAFT_RUNS_ROOT}",
  "controlled_config": "configs/qwen2_5_vl_3b_2k.yaml",
  "env": {
    "VLM_DFLASH_TARGET": "${VELADRAFT_TARGET_MODEL}",
    "VLM_DFLASH_FLEX_FORCE_MAIN": "1"
  },
  "budget": {
    "steps": 2000,
    "seeds": [
      42,
      43
    ]
  },
  "drafters": {
    "dflash": {
      "native_config": "configs/qwen2_5_vl_3b_2k.yaml",
      "regroup_support": true,
      "regroup_adaptation": false,
      "controlled_overrides": {}
    },
    "dspark": {
      "native_config": "configs/dspark/qwen2_5_vl_3b_2k.yaml",
      "regroup_support": false,
      "regroup_adaptation": false,
      "controlled_overrides": {}
    },
    "domino": {
      "native_config": "configs/domino/qwen2_5_vl_3b_2k.yaml",
      "regroup_support": false,
      "regroup_adaptation": false,
      "controlled_overrides": {}
    },
    "jetspec": {
      "native_config": "configs/jetspec/qwen2_5_vl_3b_2k.yaml",
      "regroup_support": false,
      "regroup_adaptation": false,
      "controlled_overrides": {
        "capture.store_final_hidden": true,
        "drafter.loss_decay_gamma": null
      }
    },
    "dflash2": {
      "native_config": "configs/dflash2/qwen2_5_vl_3b_2k.yaml",
      "regroup_support": false,
      "regroup_adaptation": false,
      "controlled_overrides": {
        "capture.store_final_hidden": true,
        "drafter.loss_decay_gamma": 4.0
      }
    },
    "dflare": {
      "native_config": "configs/dflare/qwen2_5_vl_3b_2k.yaml",
      "regroup_support": false,
      "regroup_adaptation": true,
      "regroup_adaptation_note": "smoke 2026-10-15: canonical/8+bypass bitwise PASS on the dflare 2k store, but grid/2 is refused at the auxiliary-metrics gate (NotImplementedError, train.py:321). Adaptation = make aux-metric accounting group-aware, then re-run regroup_adaptation_smoke.sh.",
      "controlled_overrides": {
        "drafter.capture_layer_ids": [
          1,
          17,
          33
        ]
      }
    },
    "dfly": {
      "native_config": "configs/dfly/qwen2_5_vl_3b_2k.yaml",
      "regroup_support": false,
      "regroup_adaptation": false,
      "controlled_overrides": {
        "drafter.capture_layer_ids": [
          1,
          17,
          33
        ]
      }
    }
  },
  "tracks": [
    "controlled",
    "native"
  ],
  "regroup_sets": {
    "off": [],
    "grid2": [
      "train.regroup.mode=grid",
      "train.regroup.sub_batch=2",
      "train.regroup.fp32_weights=true",
      "train.regroup.identity_bypass=true"
    ]
  },
  "stages": [
    "train",
    "eval",
    "benchmark"
  ],
  "eval": {
    "num_prompts": 64,
    "max_new_tokens": 128
  },
  "isolation": {
    "train_store": "${VELADRAFT_DATA_ROOT}/qwen25vl3b_2k/train_store",
    "val_split": "${VELADRAFT_DATA_ROOT}/qwen25vl3b_2k/val_heldout.jsonl",
    "test_workloads": [
      "caption_general",
      "textvqa",
      "docvqa",
      "chartqa"
    ],
    "note": "test workloads are public datasets exported by scripts/prepare_benchmark.py; the val split is disjoint from the train store; the runner refuses identical train/val paths, binds train_store -> <run>/features and val_split -> <run>/data/val.jsonl (media_dir normalized from <val>/meta.json or <val>/images), and validates store identity/layers in the prepare preflight"
  },
  "cost_model": {
    "sec_per_step": {
      "default": 1.3,
      "dflash": 1.2,
      "dspark": 1.5,
      "domino": 1.5,
      "jetspec": 1.5,
      "dflash2": 1.4,
      "dflare": 1.6,
      "dfly": 1.6
    },
    "eval_minutes": 12,
    "benchmark_minutes": 10
  },
  "benchmark": {
    "manifests_dir": "benchmarks/manifests",
    "reports_dir": "benchmarks/reports"
  }
}
