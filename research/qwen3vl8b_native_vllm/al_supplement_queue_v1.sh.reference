#!/bin/bash
set -uo pipefail
root=/home/lyh/qwen3vl8b_eval_20261027
harness="$root/harness_al_supplement_v1"
py="$root/runtime_frozen_v1/bin/python"
out="$root/al_supplement_v1"
mkdir -p "$out"
echo $$ > "$out/queue.pid"
export QWEN8B_DIGEST_CACHE="$root/harness_recovery_fast_v1/digest_cache.sqlite" PYTHONPATH="$harness" PYTHONDONTWRITEBYTECODE=1 VLLM_BATCH_INVARIANT=0
cd "$harness" || exit 1
while screen -ls | grep -Eq 'qwen8b_(dflare|domino|jetspec)_(speed|quality)_v1|qwen8b_backend_watch_v1'; do
 echo "WAIT_PRIMARY_RUNS $(date -Is)";sleep 120
done
monitored_run() {
 local tag="$1";shift
 local res="$out/$tag.evidence/resources.jsonl" marker="$out/$tag.foreign_abort" job rc
 setsid "$@" > "$out/$tag.launch.log" 2>&1 & job=$!
 while kill -0 "$job" 2>/dev/null;do
  if [[ -f "$res" ]] && grep -Eq '"foreign_pids": *\[[0-9]|"error":' "$res";then
   echo "FOREIGN_RESOURCE_ABORT $(date -Is) $tag" | tee "$marker"
   kill -TERM -- "-$job" 2>/dev/null || kill -TERM "$job" 2>/dev/null || true
   wait "$job" || true;return 75
  fi
  sleep 3
 done
 wait "$job";rc=$?;return "$rc"
}
for method in dflash dfly dflash2 dflare domino jetspec;do
 case "$method" in
  dflash) primary="$root/dflash_formal_v5.json";audit="$root/dflash_formal_audit_v1.json"; draft="$root/dflash_export_v1"; manifest="$root/dflash_runtime_manifest_v2.json";;
  dfly) primary="$root/dfly_8b_formal_dynamic_v11.json";audit="$root/dfly_8b_formal_dynamic_audit_v11.json";draft="$root/dfly_recovery_v2/dfly_native_adapter_v1/hf_step75000_v1";manifest="$root/dfly_recovery_v2/runtime_manifest_v2.json";;
  dflash2) primary="$root/dflash2_8b_formal_dynamic_v14.json";audit="$root/dflash2_8b_formal_dynamic_audit_v14.json";draft="$root/dflash2_recovery_v2/dflash2_8b_native_adapter/hf_step75000_v1";manifest="$root/dflash2_recovery_v2/runtime_manifest_recovery_v1.json";;
  dflare) primary="$root/dflare_8b_formal_dynamic_v11.json";audit="$root/dflare_8b_formal_dynamic_audit_v11.json";draft="$root/dflare_8b_work_20261029/dflare_8b_native_adapter/hf_step75000_v1";manifest="$root/dflare_8b_work_20261029/runtime_manifest_v1.json";;
  domino) primary="$root/domino_8b_formal_v1.json";audit="$root/domino_8b_formal_audit_v1.json";draft="$root/domino_8b_work_20261029/domino_8b_native_adapter/hf_step75000_v1";manifest="$root/domino_8b_work_20261029/runtime_manifest_v2.json";;
  jetspec) primary="$root/jetspec_8b_formal_v1.json";audit="$root/jetspec_8b_formal_audit_v1.json";draft="$root/jetspec_8b_work_20261029/jetspec_adapter/hf_export_step75000_v1";manifest="$root/jetspec_8b_work_20261029/runtime_manifest_v3.json";;
 esac
 if ! python3 -c 'import json,sys;assert all(json.load(open(x)).get("status")=="complete" for x in sys.argv[1:])' "$primary" "$audit" 2>/dev/null;then echo "SKIP_NO_VALID_PRIMARY $(date -Is) method=$method";continue;fi
 if [[ "$method" == dflare || "$method" == domino || "$method" == jetspec ]];then
  if ! python3 -c 'import json,sys;assert json.load(open(sys.argv[1])).get("status")=="complete"' "$root/${method}_8b_attention_audit_v1.json" 2>/dev/null;then echo "SKIP_BACKEND_AUDIT $(date -Is) method=$method";continue;fi
 fi
 mkdir -p "$out/$method"
 [[ ! -e "$out/$method/summary.json" ]] || { echo "AL_ALREADY_PRESENT $method";continue; }
 completed=0
 for ((attempt=1;attempt<=100;attempt++));do
  gpu=''
  while [[ -z "$gpu" ]];do
   for candidate in 2 3 0 1;do
    used=$(timeout 10 nvidia-smi -i "$candidate" --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | tr -d ' ' || true)
    pids=$(timeout 10 nvidia-smi -i "$candidate" --query-compute-apps=pid --format=csv,noheader,nounits 2>/dev/null || true)
    uuid=$(timeout 10 nvidia-smi -i "$candidate" --query-gpu=uuid --format=csv,noheader,nounits 2>/dev/null || true)
    if [[ "$used" =~ ^[0-9]+$ && "$used" -lt 500 && -z "$pids" && "$uuid" =~ ^GPU-[0-9a-fA-F-]+$ ]] && flock -n "/tmp/veladraft_gpu_locks/$uuid.lock" true;then gpu="$candidate";break;fi
   done
   [[ -n "$gpu" ]] || { echo "WAIT_AVAILABLE_GPU $(date -Is) method=$method";sleep 30; }
  done
  tag="${method}_al_v1_a$attempt";echo "AL_START $(date -Is) method=$method gpu=$gpu attempt=$attempt"
  if monitored_run "$tag" "$py" -m vlm_dflash.cli native-eval --target "$root/artifacts/target" --draft "$draft" --source "$root/mmspec_formal120.jsonl" --images-dir /home/lyh/a6000_3b_v2_L300/shared/benchmarks/mmspec/images --runtime-manifest "$manifest" --method "$method" --gpu-memory-utilization .78 --gpu "$gpu" --num-prompts 120 --max-new-tokens 1024 --repeats 1 --out "$out/$tag.json";then
   if python3 "$root/collect_al_supplement_v1.py" "$out/$tag.json" "$out/$method/summary.json";then echo "AL_COMPLETE $(date -Is) method=$method gpu=$gpu";else echo "AL_COUNTERS_UNAVAILABLE $(date -Is) method=$method";fi
   python3 "$root/build_qwen3vl8b_paper_results.py";completed=1;break
  fi
  err=$($py -c 'import json,sys;print(json.load(open(sys.argv[1])).get("error",""))' "$out/$tag.json" 2>/dev/null || true)
  echo "AL_FAILED $(date -Is) method=$method attempt=$attempt error=$err"
  if [[ -f "$out/$tag.foreign_abort" || "$err" == *"Resource temporarily unavailable"* || "$err" == *"GPU is occupied"* || "$err" == *"GPU resource evidence contaminated"* ]];then continue;fi
  break
 done
 [[ "$completed" == 1 ]] || echo "AL_UNFINISHED $(date -Is) method=$method"
done
echo "AL_QUEUE_FINISHED $(date -Is)"
