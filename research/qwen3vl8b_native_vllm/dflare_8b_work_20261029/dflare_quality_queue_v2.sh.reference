#!/bin/bash
set -euo pipefail
root=/home/lyh/qwen3vl8b_eval_20261027
work="$root/dflare_8b_work_20261029"
harness="$root/harness_resource_fix_v1"
py="$root/runtime_frozen_v1/bin/python"
out="$root/quality_dflare_campaign_v1"
export QWEN8B_DIGEST_CACHE="$root/harness_recovery_fast_v1/digest_cache.sqlite" PYTHONPATH="$harness" PYTHONDONTWRITEBYTECODE=1 VLLM_BATCH_INVARIANT=0
cd "$harness"
echo $$ > "$work/quality_queue_v1.pid"
trap 'rc=$?; echo "QUALITY_QUEUE_FAILED $(date -Is) rc=$rc line=$LINENO"' ERR
common=(--target "$root/artifacts/target" --draft "$work/dflare_8b_native_adapter/hf_step75000_v1" --source "$root/mmspec_formal120.jsonl" --images-dir /home/lyh/a6000_3b_v2_L300/shared/benchmarks/mmspec/images --runtime-manifest "$work/runtime_manifest_v1.json" --method dflare --gpu-memory-utilization .78)
monitored_run() {
 local resource="$1" marker="$2" log="$3";shift 3
 setsid "$@" > "$log" 2>&1 & local job=$!
 while kill -0 "$job" 2>/dev/null; do
  if [[ -f "$resource" ]] && grep -Eq '"foreign_pids": *\[[0-9]|"error":' "$resource";then
   echo "FOREIGN_RESOURCE_ABORT $(date -Is)" > "$marker"
   kill -TERM -- "-$job" 2>/dev/null || kill -TERM "$job" 2>/dev/null || true
   wait "$job" || true;return 75
  fi
  sleep 3
 done
 wait "$job"
}
free_gpu() {
 local g="$1" used pids uuid
 used=$(timeout 10 nvidia-smi -i "$g" --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | tr -d ' ' || true)
 pids=$(timeout 10 nvidia-smi -i "$g" --query-compute-apps=pid --format=csv,noheader,nounits 2>/dev/null || true)
 uuid=$(timeout 10 nvidia-smi -i "$g" --query-gpu=uuid --format=csv,noheader,nounits 2>/dev/null || true)
 [[ "$used" =~ ^[0-9]+$ && "$used" -lt 500 && -z "$pids" && "$uuid" =~ ^GPU-[0-9a-fA-F-]+$ ]] && flock -n "/tmp/veladraft_gpu_locks/$uuid.lock" true
}
select_gpu() {
 while :; do
  for candidate in 1 0 3 2; do
   if [[ -s "$root/dflare_dynamic_v1.pid" ]] && kill -0 "$(cat "$root/dflare_dynamic_v1.pid")" 2>/dev/null; then
    active=$(awk '/SMOKE_START|FORMAL_START/ {for(i=1;i<=NF;i++) if($i ~ /^gpu=/) {split($i,a,"=");g=a[2]}} END {print g}' "$work/speed_queue_v1.log")
    [[ -z "$active" || "$candidate" != "$active" ]] || continue
   fi
   if free_gpu "$candidate";then gpu="$candidate";return;fi
  done
  echo "WAIT_AVAILABLE_GPU $(date -Is)";sleep 30
 done
}
while [[ ! -f "$work/runtime_manifest_v1.json" ]]; do
 if ! screen -ls | grep -q qwen8b_dflare_prepare_v1; then echo PREPARATION_FAILED;exit 1;fi
 sleep 10
done
(cd "$root" && sha256sum -c quality_dflare_v1/SOURCE_SHA256.txt >/dev/null)
smoke_ok=0
for ((i=1;i<=100;i++)); do
 select_gpu;tag="dflare_8b_quality_smoke_v1_a$i"
 echo "SMOKE_START $(date -Is) gpu=$gpu attempt=$i"
 if monitored_run "$root/$tag.evidence/resources.jsonl" "$root/$tag.foreign_abort" "$root/$tag.launch.log" "$py" -m vlm_dflash.cli native-eval "${common[@]}" --gpu "$gpu" --num-prompts 1 --max-new-tokens 128 --repeats 1 --out "$root/$tag.json";then
  "$py" -c 'import json,sys;d=json.load(open(sys.argv[1]));assert d["status"]=="complete" and d["resources_verified"] and d["source_preservation"]["all_values_bitwise_equal"] and d["smoke"]' "$root/$tag.json"
  echo "SMOKE_COMPLETE $(date -Is) gpu=$gpu";smoke_ok=1;break
 fi
 err=$($py -c 'import json,sys;print(json.load(open(sys.argv[1])).get("error",""))' "$root/$tag.json" 2>/dev/null || true)
 echo "SMOKE_FAILED $(date -Is) attempt=$i error=$err"
 if [[ -f "$root/$tag.foreign_abort" || "$err" == *"Resource temporarily unavailable"* || "$err" == *"GPU is occupied"* || "$err" == *"GPU resource evidence contaminated"* ]];then continue;fi
 exit 1
done
[[ "$smoke_ok" == 1 ]]
plan="$root/$tag.evidence/plan.json";sha=$(sha256sum "$plan" | cut -d ' ' -f1)
mkdir -p "$out"
for arm in ar sd; do
 if [[ "$arm" == ar ]];then label=ar;else label=dflare;fi
 done_arm=0
 for ((j=1;j<=100;j++)); do
  until free_gpu "$gpu";do echo "WAIT_SELECTED_GPU $(date -Is) gpu=$gpu";sleep 30;done
  dir="$out/${label}_attempt$j";marker="$out/${label}_attempt$j.foreign_abort"
  echo "QUALITY_START $(date -Is) $label gpu=$gpu attempt=$j"
  if monitored_run "$dir/resources.jsonl" "$marker" "$out/${label}_attempt$j.launch.log" env CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES="$gpu" VLLM_WORKER_MULTIPROC_METHOD=spawn VLLM_BATCH_INVARIANT=0 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false PYTHONDONTWRITEBYTECODE=1 VELADRAFT_NATIVE_PLAN="$plan" VELADRAFT_NATIVE_PLAN_SHA256="$sha" VELADRAFT_NATIVE_ARM="$arm" VLLM_CACHE_ROOT="$out/caches/$label" TORCHINDUCTOR_CACHE_DIR="$out/caches/$label/inductor" PYTHONPATH="$harness/vlm_dflash/eval/native_bootstrap:$harness:$root" "$py" -m quality_dflare_v1.runner --arm "$arm" --method dflare --gpu "$gpu" --directory "$dir";then
   "$py" -c 'import json,sys;d=json.load(open(sys.argv[1]));assert d["status"]=="complete" and d["failures"]==0 and d["resource_evidence"]["status"]=="complete"' "$dir/quality.json"
   mv "$dir" "$out/$label";done_arm=1;echo "QUALITY_COMPLETE $(date -Is) $label";break
  fi
  err=$($py -c 'import json,sys;print(json.load(open(sys.argv[1])).get("error",""))' "$dir/quality.json" 2>/dev/null || true)
  echo "QUALITY_FAILED $(date -Is) $label attempt=$j error=$err"
  if [[ -f "$marker" || "$err" == *"Resource temporarily unavailable"* || "$err" == *"GPU is occupied"* || "$err" == *"GPU resource evidence contaminated"* ]];then continue;fi
  exit 1
 done
 [[ "$done_arm" == 1 ]]
done
PYTHONPATH="$harness:$root" "$py" -m quality_dflare_v1.compare_quality --root "$out" --out "$out/QUALITY_PAIRED_V1.json"
echo "QUALITY_QUEUE_COMPLETE $(date -Is)"
