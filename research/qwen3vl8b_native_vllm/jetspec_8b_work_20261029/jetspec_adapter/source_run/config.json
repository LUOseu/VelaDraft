{
  "algorithm": {
    "name": "jetspec",
    "jetspec": {
      "kd_temperature": 1.0,
      "kd_chunk_size": 1024
    }
  },
  "target": {
    "model": "/data/Qwen3-VL-8B-Instruct",
    "dtype": "bfloat16",
    "attn_implementation": "sdpa",
    "device": "cuda:1",
    "local_files_only": true,
    "image_min_pixels": 65536,
    "image_max_pixels": 1048576,
    "chat_template_kwargs": {
      "enable_thinking": false
    }
  },
  "dataset": {
    "slice": null,
    "val_size": 64,
    "seed": 42,
    "min_answer_chars": 600,
    "source": "jsonl",
    "path": "/data/runs/veladraft/qwen3vl8b_200k_s42/data/pool/pool.jsonl",
    "split_field": "split",
    "image_link_mode": "hardlink"
  },
  "regen": {
    "max_new_tokens": 2048,
    "min_response_tokens": 8,
    "batch_size": 8,
    "temperature": 0.7,
    "backend": "vllm",
    "top_p": 0.8,
    "top_k": 20,
    "presence_penalty": 0.0,
    "repetition_penalty": 1.0,
    "max_prompt_tokens": 2048,
    "window_tokens": 4096,
    "seed": 42,
    "multi_turn_mode": "last_turn_only",
    "select": {
      "meta": "/data/runs/veladraft/qwen3vl8b_200k_s42/data/pool/pool_meta.jsonl",
      "quotas": {
        "general": 70000,
        "ocr": 60000,
        "chart": 30000,
        "reasoning": 40000
      }
    }
  },
  "capture": {
    "seq_length": 4096,
    "shard_size": 32,
    "dtype": "bfloat16",
    "visual_path_check": true,
    "visual_check_samples": 4,
    "store_final_hidden": true
  },
  "drafter": {
    "num_hidden_layers": 3,
    "block_size": 8,
    "num_anchors": 512,
    "loss_decay_gamma": null,
    "mask_token_id": 151669,
    "attention_backend": "flex_attention",
    "spatial_rope_enabled": true,
    "spatial_rope_mode": "replace",
    "hidden_size": 4096,
    "intermediate_size": 12288,
    "num_attention_heads": 32,
    "num_key_value_heads": 8,
    "head_dim": 128,
    "spatial_rope_interleaved": true,
    "spatial_rope_sections": [
      24,
      20,
      20
    ]
  },
  "train": {
    "feature_mode": "online",
    "micro_batch_size": 2,
    "grad_accumulation_steps": 4,
    "num_epochs": 3,
    "lr": 0.0001,
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.0,
    "warmup_ratio": 0.04,
    "min_lr_ratio": 0.1,
    "max_grad_norm": 1.0,
    "log_every_steps": 10,
    "seed": 42,
    "device": "cuda:0",
    "overfit_sanity": {
      "enabled": true,
      "num_samples": 4,
      "steps": 200,
      "ce_drop": 0.6,
      "slot0_acc": 0.9
    },
    "online_batch_size": 1,
    "online_feature_cache_gb": 0,
    "num_workers": 0,
    "draft_dtype": "bfloat16",
    "save_every_steps": 1250,
    "milestone_snapshots": true,
    "snapshot_every_steps": 12500,
    "stage_timing": true
  },
  "eval": {
    "num_prompts": 64,
    "max_new_tokens": 128,
    "sequential_target_verification": true,
    "verify_sdpa_backend": "parity",
    "parallel_diagnostic_prompts": 16,
    "checkpoints": [
      "ckpt_final.pt",
      "ckpt_init.pt"
    ],
    "verification": "sequential"
  },
  "run": {
    "name": "qwen3vl8b_200k_s42_jetspec",
    "dir": "runs/qwen3vl8b_200k_s42_jetspec"
  }
